{
  "name": "crazy-universe",
  "displayName": "Crazy Universe",
  "description": "%extension.description%",
  "version": "1.1.0",
  "publisher": "CrazyUniverse",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tqy43/Crazy_Universe"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "crazyUniverse",
          "title": "Crazy Universe",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "crazyUniverse": [
        {
          "id": "crazyUniverse.tasks",
          "name": "%view.tasks%",
          "type": "webview",
          "contextualTitle": "Crazy Universe"
        },
        {
          "id": "crazyUniverse.timeline",
          "name": "%view.timeline%",
          "type": "webview",
          "contextualTitle": "%view.timeline%"
        }
      ]
    },
    "commands": [
      {
        "command": "crazyUniverse.newTask",
        "title": "%command.newTask%",
        "category": "Crazy Universe",
        "icon": "$(add)"
      },
      {
        "command": "crazyUniverse.startTask",
        "title": "%command.startTask%",
        "category": "Crazy Universe",
        "icon": "$(play)"
      },
      {
        "command": "crazyUniverse.pauseTask",
        "title": "%command.pauseTask%",
        "category": "Crazy Universe",
        "icon": "$(debug-pause)"
      },
      {
        "command": "crazyUniverse.resumeTask",
        "title": "%command.resumeTask%",
        "category": "Crazy Universe",
        "icon": {
          "light": "resources/action-resume.svg",
          "dark": "resources/action-resume-dark.svg"
        }
      },
      {
        "command": "crazyUniverse.completeTask",
        "title": "%command.completeTask%",
        "category": "Crazy Universe",
        "icon": "$(check)"
      },
      {
        "command": "crazyUniverse.addNote",
        "title": "%command.addNote%",
        "category": "Crazy Universe",
        "icon": {
          "light": "resources/action-note.svg",
          "dark": "resources/action-note-dark.svg"
        }
      },
      {
        "command": "crazyUniverse.openTimeline",
        "title": "%command.openTimeline%",
        "category": "Crazy Universe"
      },
      {
        "command": "crazyUniverse.focus",
        "title": "%command.focus%",
        "category": "Crazy Universe"
      },
      {
        "command": "crazyUniverse.filterTasks",
        "title": "%command.filterTasks%",
        "category": "Crazy Universe",
        "icon": "$(search)"
      },
      {
        "command": "crazyUniverse.toggleLanguage",
        "title": "%command.toggleLanguage%",
        "category": "Crazy Universe",
        "icon": {
          "light": "resources/action-locale.svg",
          "dark": "resources/action-locale-dark.svg"
        }
      },
      {
        "command": "crazyUniverse.openTools",
        "title": "%command.openTools%",
        "category": "Crazy Universe",
        "icon": {
          "light": "resources/action-tools.svg",
          "dark": "resources/action-tools-dark.svg"
        }
      },
      {
        "command": "crazyUniverse.loginWorklog",
        "title": "%command.loginWorklog%",
        "category": "Crazy Universe"
      },
      {
        "command": "crazyUniverse.filterTimeline",
        "title": "%command.filterTimeline%",
        "category": "Crazy Universe",
        "icon": "$(filter)"
      },
      {
        "command": "crazyUniverse.deleteTask",
        "title": "%command.deleteTask%",
        "category": "Crazy Universe"
      },
      {
        "command": "crazyUniverse.renameTask",
        "title": "%command.renameTask%",
        "category": "Crazy Universe"
      },
      {
        "command": "crazyUniverse.statusBarPick",
        "title": "%command.statusBarPick%",
        "category": "Crazy Universe",
        "icon": "$(menu)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "crazyUniverse.startTask",
          "when": "crazyUniverse.hasSelection && crazyUniverse.selectionStatus =~ /not_started|paused/"
        },
        {
          "command": "crazyUniverse.pauseTask",
          "when": "crazyUniverse.hasActiveTask || crazyUniverse.selectionStatus == in_progress"
        },
        {
          "command": "crazyUniverse.resumeTask",
          "when": "crazyUniverse.selectionStatus == completed"
        },
        {
          "command": "crazyUniverse.completeTask",
          "when": "crazyUniverse.selectionStatus =~ /in_progress|paused/"
        },
        {
          "command": "crazyUniverse.addNote",
          "when": "crazyUniverse.hasSelection"
        },
        {
          "command": "crazyUniverse.filterTimeline",
          "when": "crazyUniverse.hasSelection"
        },
        {
          "command": "crazyUniverse.openTimeline",
          "when": "crazyUniverse.hasSelection"
        },
        {
          "command": "crazyUniverse.loginWorklog",
          "when": "config.crazyUniverse.worklog.enabled"
        },
        {
          "command": "crazyUniverse.deleteTask",
          "when": "crazyUniverse.hasSelection"
        },
        {
          "command": "crazyUniverse.renameTask",
          "when": "crazyUniverse.hasSelection"
        },
        {
          "command": "crazyUniverse.statusBarPick"
        }
      ],
      "view/title": [
        {
          "command": "crazyUniverse.toggleLanguage",
          "when": "view == crazyUniverse.tasks",
          "group": "navigation@0"
        },
        {
          "command": "crazyUniverse.openTools",
          "when": "view == crazyUniverse.tasks",
          "group": "navigation@1"
        },
        {
          "command": "crazyUniverse.filterTasks",
          "when": "view == crazyUniverse.tasks",
          "group": "navigation@2"
        },
        {
          "command": "crazyUniverse.newTask",
          "when": "view == crazyUniverse.tasks",
          "group": "navigation@3"
        },
        {
          "command": "crazyUniverse.filterTimeline",
          "when": "view == crazyUniverse.timeline && crazyUniverse.hasSelection && crazyUniverse.timelineFeed == events",
          "group": "navigation@0"
        },
        {
          "command": "crazyUniverse.addNote",
          "when": "view == crazyUniverse.timeline && crazyUniverse.hasSelection && crazyUniverse.timelineFeed == events",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Crazy Universe",
      "properties": {
        "crazyUniverse.snapshot.includeOpenFiles": {
          "type": "boolean",
          "default": true,
          "description": "%config.includeOpenFiles%"
        },
        "crazyUniverse.snapshot.includeChangedPaths": {
          "type": "boolean",
          "default": true,
          "description": "%config.includeChangedPaths%"
        },
        "crazyUniverse.locale": {
          "type": "string",
          "enum": ["auto", "en", "zh-cn"],
          "enumDescriptions": [
            "%config.locale.auto%",
            "%config.locale.en%",
            "%config.locale.zh-cn%"
          ],
          "default": "auto",
          "description": "%config.locale%"
        },
        "crazyUniverse.worklog.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.worklog.enabled%"
        },
        "crazyUniverse.worklog.running": {
          "type": "boolean",
          "default": true,
          "description": "%config.worklog.running%"
        },
        "crazyUniverse.worklog.userId": {
          "type": "string",
          "default": "",
          "description": "%config.worklog.userId%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "lint": "tsc --noEmit",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
